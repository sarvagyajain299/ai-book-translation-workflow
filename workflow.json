      "parameters": {
        "jsCode": "// 1. Get input data\nconst inputData = $('combine markdown1').first().json.combined_markdown || \"\";\n\n// 2. Split by the word \"SLOT\"\n// This creates an array: [TextBeforeSlot, Slot1Content, Slot2Content, ...]\nlet slots = inputData.split(/SLOT/i);\n\n// 3. REMOVE THE FIRST ELEMENT\n// This removes everything that was before the very first \"SLOT\"\nslots.shift();\n\n// 4. Transform to n8n format\n// We filter to remove any empty items to ensure Gemini doesn't get blank inputs\nreturn slots\n    .map(text => text.trim())\n    .filter(text => text.length > 0)\n    .map((content) => {\n        return {\n            json: {\n                content: content\n            }\n        };\n    });"
